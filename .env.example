PORT=5000
# Same secret signs login, email-verify and password-reset tokens. Replace with a long random string before going live.
ACCESS_TOKEN_SECRET=CHANGE_ME_long_random_string

MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pawvana?appName=Cluster0

# Address of THIS server as the PHONE sees it (same value as EXPO_PUBLIC_API_URL in the app).
# Used for the payment return page and for the "open in app" links inside emails.
PUBLIC_API_URL=http://192.168.0.100:5000

# true = every admin/cart/order route needs "Authorization: Bearer <token>" (login returns the token).
# Leave false until the app sends the token (see README), otherwise the current app will get "Unauthorized".
ENFORCE_AUTH=false

# Email (Gmail app password). If empty, links are printed in the server console instead of emailed.
SMTP_USER=
SMTP_PASS=

# aamarPay sandbox test store. Replace with your live store id / signature key when you go live.
AAMARPAY_STORE_ID=aamarpaytest
AAMARPAY_SIGNATURE_KEY=dbb74894e82415a2f7ff0ec3a97e4183
AAMARPAY_BASE_URL=https://sandbox.aamarpay.com

# Web storefront origin(s), comma-separated. Payment returns and email links go here for requests coming from the website.
WEB_URL=http://localhost:5173
